# 真实访客 IP：从 Cloudflare 隧道来的请求（来自本机）才相信 CF-Connecting-IP，直连 8090 的用对方地址
map $remote_addr $eclipsis_client_ip {
    127.0.0.1 $http_cf_connecting_ip;
    ::1       $http_cf_connecting_ip;
    default   $remote_addr;
}
# 隧道过来的是 https；直连 8090 是 http（登录 cookie 据此决定要不要加 Secure）
map $http_x_forwarded_proto $eclipsis_proto {
    https   https;
    default $scheme;
}

server {
    listen 8090;
    server_name _;
    root /opt/eclipsis/dist;
    index index.html;

    client_max_body_size 20m;
    # 跳转用相对地址：从隧道来时 nginx 看到的是 http:8090，写成绝对地址会跳错
    absolute_redirect off;

    # ===== 登录保护：除了登录页和图标，每个请求都要先通过 eclipsis-auth 验证 =====
    auth_request /_auth;
    error_page 401 = @need_login;

    location = /_auth {
        internal;
        proxy_pass http://127.0.0.1:3470/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    # 页面：跳到登录页，登录后回到原来的地址
    location @need_login {
        return 302 /login?next=$request_uri;
    }
    # 接口：返回 401 并带标记，前端看到后自动跳登录页
    location @need_login_api {
        add_header X-Eclipsis-Auth required always;
        default_type application/json;
        return 401 '{"error":"需要登录"}';
    }

    location = /login {
        auth_request off;
        proxy_pass http://127.0.0.1:3470/login$is_args$args;
        proxy_set_header X-Client-Ip $eclipsis_client_ip;
        proxy_set_header X-Forwarded-Proto $eclipsis_proto;
        client_max_body_size 4k;
    }
    location = /logout {
        auth_request off;
        proxy_pass http://127.0.0.1:3470/logout;
    }

    # 登录页要用到的图标、头像、主屏幕配置，不需要登录
    location ~ ^/(apple-touch-icon\.png|icon-192\.png|icon-512\.png|manifest\.webmanifest|avatar-claude\.jpg|avatar-erica\.jpg)$ {
        auth_request off;
        add_header Cache-Control "no-cache";
    }

    # API → Dylan 网关。网关 key 由服务器注入，前端代码里不再出现。
    location /api/ {
        error_page 401 = @need_login_api;
        proxy_pass http://127.0.0.1:3457/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $eclipsis_client_ip;
        include /etc/nginx/secrets/eclipsis-gateway.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    # MCP 中转：只允许白名单端口（OB 18001 / 心潮 18110 / 网易云 3456）
    location ~ ^/mcp-relay/(18001|18110|3456)(/.*)$ {
        error_page 401 = @need_login_api;
        proxy_pass http://127.0.0.1:$1$2$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $eclipsis_client_ip;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Content-Type $content_type;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
    location /mcp-relay/ {
        error_page 401 = @need_login_api;
        return 403;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
