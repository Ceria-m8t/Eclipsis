# 复制到 /etc/eclipsis/backend.env（chmod 600），填好后 systemctl restart eclipsis-backend

# ===== 换站只改这两行 =====
UPSTREAM_URL=https://example.com/v1
UPSTREAM_KEY=sk-xxxx

# xiaoke 调用上游入口用的本地密钥：xiaoke/.env 的 XIAOKE_UPSTREAM_KEY 填同一个值（一次性，之后不用改）
TAP_KEY=

# 前端出口 → Dylan
DYLAN_URL=http://127.0.0.1:3457/v1
FRONT_PORT=3480
TAP_PORT=3481

# 1 = 前端出口在请求体里带 eclipsis_rid，上游入口删掉后再发给中转站，两边记录对得上。
# 只有在 xiaoke 已经指向上游入口之后才能开，否则这个字段会直接发到中转站。
LINK_RID=0

HEADER_TIMEOUT_MS=120000
DB_PATH=/var/lib/eclipsis/eclipsis.sqlite
BLOB_DIR=/var/lib/eclipsis/blobs
